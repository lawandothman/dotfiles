# Rose Pine, matching the Neovim highlight groups of the same name.
# set -g rather than -U so the repo stays the only source of truth.

set -g fish_color_normal '#e0def4'
set -g fish_color_command '#ebbcba'
set -g fish_color_keyword '#31748f'
set -g fish_color_option '#c4a7e7'
set -g fish_color_param '#e0def4'
set -g fish_color_quote '#f6c177'
set -g fish_color_escape '#9ccfd8'
set -g fish_color_operator '#908caa'
set -g fish_color_end '#908caa'
set -g fish_color_redirection '#c4a7e7'
set -g fish_color_comment '#908caa' --italics
set -g fish_color_error '#eb6f92'
set -g fish_color_autosuggestion '#6e6a86'
set -g fish_color_valid_path --underline
set -g fish_color_cwd '#9ccfd8'
set -g fish_color_cwd_root '#eb6f92'
set -g fish_color_user '#9ccfd8'
set -g fish_color_host '#e0def4'
set -g fish_color_host_remote '#f6c177'
set -g fish_color_status '#eb6f92'
set -g fish_color_cancel '#6e6a86'
set -g fish_color_search_match --background='#403d52'
set -g fish_color_selection '#e0def4' --background='#403d52'
set -g fish_color_history_current --bold

set -g fish_pager_color_progress '#908caa' --background='#21202e'
set -g fish_pager_color_background
set -g fish_pager_color_prefix '#c4a7e7' --bold
set -g fish_pager_color_completion '#e0def4'
set -g fish_pager_color_description '#6e6a86' --italics
set -g fish_pager_color_selected_background --background='#403d52'
set -g fish_pager_color_selected_prefix '#c4a7e7' --bold
set -g fish_pager_color_selected_completion '#e0def4'
set -g fish_pager_color_selected_description '#908caa' --italics
