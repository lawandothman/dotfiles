.DS_Store

# fish universal variables (runtime)
home/.config/fish/fish_variables

# herdr runtime state
home/.config/herdr/*.log
home/.config/herdr/*.sock
home/.config/herdr/session.json
home/.config/herdr/.plugins.lock

# Claude Code local settings
home/.config/nvim/.claude/

# nvim scratch/runtime
home/.config/nvim/spell/
home/.config/nvim/tags

# plugin lockfile — checker is enabled instead
home/.config/nvim/lazy-lock.json

# recorded by dot when a package fails to install
.failed-packages
